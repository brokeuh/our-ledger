rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone signed in (including anonymous) can read/write all collections.
    // There's no real per-user ownership here — it's meant to be shared
    // between two people who both sign in anonymously from this one app.
    match /{collection}/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
